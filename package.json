{
  "name": "onetimeonetime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx apps/web/src/server/index.ts",
    "dev:worker": "tsx apps/worker/src/main/index.ts",
    "build": "npm run clean && npm run build:client && npm run build:pages && npm run typecheck",
    "build:client": "vite build --config apps/web/vite.public.config.ts && vite build --config apps/web/vite.app.config.ts",
    "build:pages": "tsx scripts/build-public-pages.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node --import tsx apps/web/src/server/index.ts",
    "start:worker": "node --import tsx apps/worker/src/main/index.ts",
    "start:rabbi-telegram": "node --import tsx apps/telegram-bot/src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "brand:check": "tsx scripts/brand-system/check.ts",
    "brand:fixtures": "tsx scripts/brand-system/write-visual-fixture.ts",
    "brand:visual": "npm run brand:fixtures && playwright test tests/e2e/ot112-visual-contracts.spec.ts",
    "secret:scan": "node scripts/secret-scan.mjs",
    "unit": "vitest run --config vitest.unit.config.ts",
    "integration": "vitest run --config vitest.integration.config.ts",
    "test": "npm run unit && npm run integration",
    "e2e": "npm run build && playwright test tests/e2e",
    "accessibility": "npm run build && playwright test tests/accessibility",
    "performance": "npm run build && playwright test tests/performance && tsx scripts/check-bundles.ts",
    "verify": "npm run secret:scan && npm run format && npm run brand:check && npm run lint && npm run typecheck && npm run test && npm run e2e && npm run accessibility && npm run performance",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:verify": "tsx scripts/verify-migrations.ts",
    "full-app:provision-staging": "tsx scripts/full-app-staging-live/provision-preview-cli.ts",
    "zoom:demo-students": "node --import tsx scripts/smoke-zoom-demo-students.mjs",
    "zoom:real-control:provision": "tsx scripts/zoom-real-control-provision.ts",
    "zoom:real-control:disposable:provision": "tsx scripts/zoom-disposable-canary-provision.ts",
    "zoom:real-control:disposable:cleanup": "tsx scripts/zoom-disposable-canary-cleanup.ts",
    "zoom:protected-target:inspect": "tsx scripts/zoom-protected-target-inspection.ts",
    "zoom:real-control:disposable:reconcile-cleanup": "tsx scripts/zoom-disposable-canary-reconcile-cleanup.ts",
    "zoom:real-control:disposable:classify-scope": "tsx scripts/zoom-disposable-canary-scope-diagnostic.ts",
    "stripe:test:resources:validate": "tsx scripts/ot87-stripe-test-resources.ts validate",
    "stripe:test:resources:setup": "tsx scripts/ot87-stripe-test-resources.ts setup",
    "stripe:test:canary": "tsx scripts/ot105-stripe-test-canary.ts",
    "billing:reconcile:test": "tsx scripts/ot87-billing-reconcile-test.ts --scope=family --dry-run",
    "billing:reconcile:test:apply": "tsx scripts/ot87-billing-reconcile-test.ts --scope=family --apply",
    "ops06:alerts": "tsx scripts/ops06-alert-eval.ts",
    "ops06:probes": "tsx scripts/ops06-synthetic-probes.ts",
    "ops06:migrations": "tsx scripts/ops06-migration-safety.ts",
    "ops06:load": "tsx scripts/ops06-load-backpressure.ts",
    "ops06:backup-restore": "tsx scripts/ops06-backup-restore.ts",
    "ops06:verify": "npm run ops06:alerts && npm run ops06:migrations && npm run ops06:probes && npm run ops06:load && npm run ops06:backup-restore",
    "outbox:sink": "tsx apps/worker/src/main/index.ts --once",
    "version:print": "tsx scripts/print-version.ts",
    "tisha:registration:inspect": "tsx scripts/tisha-bav/inspect-registration-delivery.ts",
    "director:truth": "node scripts/check-director-truth.mjs",
    "director:truth:live": "node scripts/check-director-truth.mjs --live",
    "learning-delivery:real-canary": "tsx scripts/media/learning-delivery-real-media-canary.ts",
    "highlevel:registry:check": "tsx scripts/highlevel/validate-registry.ts",
    "highlevel:workflow-control:check": "tsx scripts/highlevel/workflow-control-report.ts",
    "highlevel:workflow-control:report": "tsx scripts/highlevel/workflow-control-report.ts --write",
    "highlevel:workflow-control:projection-check": "tsx scripts/highlevel/sync-workflow-control-projections.ts",
    "highlevel:workflow-control:sync": "tsx scripts/highlevel/sync-workflow-control-projections.ts --write",
    "goal:validate": "tsx scripts/ops/validate-ot-launch-governance.ts",
    "goal:pointer:sync": "tsx scripts/ops/validate-ot-launch-governance.ts --write-pointer",
    "goal:launch-status:check": "tsx scripts/ops/generate-operator-launch-status.ts --check",
    "goal:launch-status:sync": "tsx scripts/ops/generate-operator-launch-status.ts --write",
    "highlevel:assets:reconcile": "tsx scripts/highlevel/reconcile-api-schema.ts",
    "highlevel:agent-mode:queue": "tsx scripts/highlevel/generate-agent-mode-queue.ts",
    "content-factory:import": "tsx scripts/media/content-factory-import.ts",
    "content-factory:seed-demo": "tsx scripts/media/content-factory-demo-seed.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "libphonenumber-js": "^1.13.8",
    "pg": "^8.16.3",
    "pino": "^9.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.3",
    "stripe": "^22.3.1",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.54.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.14",
    "@types/pg": "^8.15.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "js-yaml": "^4.3.0",
    "pg-mem": "^3.0.5",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
