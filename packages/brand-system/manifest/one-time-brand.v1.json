  "shells": {
    "public-marketing": { "chrome": ["header", "ticker-allowlist", "footer"] },
    "auth": { "chrome": ["header", "footer"], "ticker": false },
    "owner-admin": { "chrome": ["app-header", "app-sidebar", "app-footer"], "ticker": false },
    "parent": { "chrome": ["app-header", "parent-content", "app-footer"], "ticker": false },
    "student": { "chrome": ["app-header", "student-content", "app-footer"], "ticker": false },
    "authenticated-support": {
      "chrome": ["app-header", "support-content", "app-footer"],
      "ticker": false
    }
  },
  "routes": {
    "/": "public-marketing",
    "/signup": "auth",
    "/login": "auth",
    "/activate": "auth",
    "/forgot-password": "auth",
    "/reset-password": "auth",
    "/privacy": "public-marketing",
    "/terms": "public-marketing",
    "/404.html": "public-marketing",
    "/one-time": "public-marketing",
    "/one-time/signup": "auth",
    "/rabbi-member": "auth",
    "/app/crm": "owner-admin",
    "/app/crm/contacts/:contactId": "owner-admin",
    "/app/crm/contacts/:contactId/communications": "owner-admin",
    "/app/dashboard": "owner-admin",
    "/app/classes": "owner-admin",
    "/app/content": "owner-admin",
    "/app/billing": "owner-admin",
    "/app/billing/checkout/redirect/:redirectKey": "owner-admin",
    "/app/billing/portal/redirect/:redirectKey": "owner-admin",
    "/app/communications": "owner-admin",
    "/app/support": "authenticated-support",
    "/app/support/receipts/:receiptId": "authenticated-support",
    "/app/parent": "parent",
    "/app/student": "student",
    "/classroom/launch/:grantKey/:secret": "student"
  },
  "ticker": {
    "allowlist": ["/"],
    "copyMeaning": "Join now - free until Rosh Hashanah",
    "destination": "/signup",
    "timezone": "Asia/Jerusalem",
    "deadlineSource": "packages/domain/src/landing/content.ts",
    "motionEnabled": "moving repeated track",
    "reducedMotion": "one static readable item",
    "prohibitedLandingFragments": [
      "$67/month afterward",
      "$67",
      "monthly price",
      "trial",
      "No card today"
    ]
  },
  "accessibility": {
    "contrast": "WCAG 2.2 AA",
    "focusVisible": true,
    "touchTargetCssPx": 44,
    "reducedMotion": true,
    "rtlLogicalSpacing": true,
    "noColorOnlyState": true
  },
  "deprecations": {
    "routeLocalTokens": "Route-local raw palettes and font-family declarations are not allowed.",
    "runtimeStyleInjection": "Route-wide runtime style injection is not allowed.",
    "duplicatePrimitives": "Core headers, footers, buttons, toolbars, drawers, dialogs, cards, form controls, tables, and states belong in the brand-system package."
  },
  "compatibility": {
    "staticEntrypoint": "@onetime/brand-system/static",
    "reactEntrypoint": "@onetime/brand-system/react",
    "publicReactAllowed": false,
    "offlineUsable": true
  }
