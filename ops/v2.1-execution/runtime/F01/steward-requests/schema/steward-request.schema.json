{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onetimeonetime.com/schemas/v2.1/steward-request.schema.json",
  "title": "One Time v2.1 Steward Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "execution_id",
    "request_id",
    "task_id",
    "kind",
    "requirement_ids",
    "acceptance_case_ids",
    "rationale",
    "desired_semantic_change",
    "proposed_symbols_routes_keys_or_dependencies",
    "compatibility_assumptions",
    "verification_performed",
    "conflicts_or_risks",
    "contains_secret_or_private_data"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "execution_id": { "const": "OT-V21-PRODUCTION" },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]+-[a-z0-9-]+-[0-9]{3}$"
    },
    "task_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]+$" },
    "kind": {
      "enum": [
        "server_feature_registration",
        "client_route_registration",
        "worker_runner_registration",
        "config_key",
        "dependency",
        "barrel_export",
        "root_route",
        "app_shell",
        "migration",
        "global_style",
        "deployment_manifest",
        "retired_surface"
      ]
    },
    "requirement_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^OTV2-[A-Z0-9-]+$" }
    },
    "acceptance_case_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^OTV2-[A-Z0-9-]+-AC[0-9]{2}$" }
    },
    "rationale": { "type": "string", "minLength": 1 },
    "desired_semantic_change": { "type": "string", "minLength": 1 },
    "proposed_symbols_routes_keys_or_dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "compatibility_assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "verification_performed": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "conflicts_or_risks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "contains_secret_or_private_data": { "const": false }
  }
}
