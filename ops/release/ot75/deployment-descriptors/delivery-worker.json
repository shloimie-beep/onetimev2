{
  "schema_version": 1,
  "descriptor_id": "ot75-delivery-worker",
  "service_key": "delivery-worker",
  "mode": "descriptor_only_not_deployed",
  "current_runtime_composition_change": false,
  "start_command_template": ["node", "--import", "tsx", "apps/worker/src/main/index.ts"],
  "queue_contract": {
    "lease_required": true,
    "lease_ms_env": "DELIVERY_CLAIM_LEASE_MS",
    "batch_size_env": "DELIVERY_BATCH_SIZE",
    "source_sha_env": "OT75_EXPECTED_SOURCE_SHA",
    "non_overlapping_claims_required": true
  },
  "required_environment_names": [
    "OT75_STAGING_DELIVERY_WORKER_SERVICE",
    "OT75_WORKER_ISOLATION_APPROVED",
    "OT75_EXPECTED_SOURCE_SHA"
  ],
  "must_not_modify": ["apps/worker/src/main/index.ts", "package.json", "railway.json"],
  "allowed_release_outputs": [
    "pending_count",
    "claimed_count",
    "delivered_count",
    "failed_count",
    "lease_conflict_count"
  ]
}
