# Names only. Never commit live values.
NODE_ENV=development
DELIVERY_ENVIRONMENT=local
PORT=3000
PUBLIC_BASE_URL=https://join.onetimeonetime.com
APP_VERSION=local
COMMIT_SHA=local

# Database
DATABASE_URL=
DATABASE_SSL=false
RUN_MIGRATIONS_ON_STARTUP=false
TRUSTED_PROXY_HOPS=0

# Protected operations diagnostics. Names only; keep values in protected runtime config.
OPERATIONS_PROBE_TOKEN=
OPERATIONS_WORKER_HEARTBEAT_TTL_MS=90000

# Public lead capture
ONE_TIME_ACCOUNT_KEY=one_time
ONE_TIME_PRODUCT_KEY=one_time_mishnah_class
ONE_TIME_OWNER_INTERNAL_LABEL=Rabbi
ONE_TIME_ADMIN_CUSTOMER_LABEL=Admin
