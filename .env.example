# Names only. Never commit live values.
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=https://join.onetimeonetime.com
APP_VERSION=local
COMMIT_SHA=local

# Database
DATABASE_URL=
DATABASE_SSL=false
RUN_MIGRATIONS_ON_STARTUP=false
TRUSTED_PROXY_HOPS=0

# Public lead capture
ONE_TIME_ACCOUNT_KEY=one_time
ONE_TIME_PRODUCT_KEY=one_time_mishnah_class
ONE_TIME_OWNER_INTERNAL_LABEL=Rabbi
ONE_TIME_ADMIN_CUSTOMER_LABEL=Admin
LEAD_RATE_LIMIT_WINDOW_MS=60000
LEAD_RATE_LIMIT_MAX=5
LEAD_IDENTIFIER_RATE_LIMIT_MAX=3
LEAD_ACCOUNT_RATE_LIMIT_MAX=120
LEAD_GLOBAL_RATE_LIMIT_MAX=600

# Login, session, and MFA
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_IDENTIFIER_RATE_LIMIT_MAX=5
LOGIN_IP_RATE_LIMIT_MAX=30
LOGIN_ACCOUNT_RATE_LIMIT_MAX=120
LOGIN_GLOBAL_RATE_LIMIT_MAX=600
SESSION_LAST_SEEN_WRITE_INTERVAL_MS=300000
AUTH_CSRF_SECRET=
MFA_SECRET_ENCRYPTION_KEY=

# Transactional outbox sink/mock mode
OUTBOX_TRANSPORT_MODE=sink
ONE_TIME_EMAIL_FROM=
ONE_TIME_EMAIL_REPLY_TO=
ONE_TIME_DELIVERY_OWNER_ALERT_EMAIL=
ONE_TIME_PROTECTED_CLASS_TARGET_URL=
ONE_TIME_OWNER_TEST_WHATSAPP=
ONE_TIME_OWNER_TEST_EMAIL=

# OT-89A subscriber support producer. Disabled unless all delivery/HMAC values are configured.
OT89_SUPPORT_ENABLED=false
OT89_SUPPORT_DELIVERY_MODE=disabled
OT89_SUPPORT_BNA_BASE_URL=
OT89_SUPPORT_HMAC_KEY_ID=
OT89_SUPPORT_HMAC_SECRET=
OT89_BNA_TO_ONETIME_HMAC_KEY_ID=
OT89_BNA_TO_ONETIME_HMAC_SECRET=
OT89_MOCK_BNA_ENABLED=false
OT89_MOCK_BNA_OUTAGE=false
OT89_SUPPORT_DEPLOYMENT_ID=

# Production guardrails
ENABLE_REAL_EMAIL_TRANSPORT=false
ENABLE_REAL_WHATSAPP_TRANSPORT=false
ENABLE_REAL_TELEGRAM_TRANSPORT=false
ENABLE_PAYMENT_TRANSPORT=false
