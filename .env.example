# Names only. Never commit live values.
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=https://join.onetimeonetime.com
APP_VERSION=local
COMMIT_SHA=local

# Database
DATABASE_URL=
DATABASE_SSL=false
RUN_MIGRATIONS_ON_STARTUP=false

# Public lead capture
ONE_TIME_ACCOUNT_KEY=one_time
ONE_TIME_PRODUCT_KEY=one_time_mishnah_class
ONE_TIME_OWNER_INTERNAL_LABEL=Rabbi
ONE_TIME_ADMIN_CUSTOMER_LABEL=Admin
LEAD_RATE_LIMIT_WINDOW_MS=60000
LEAD_RATE_LIMIT_MAX=5

# Transactional outbox sink/mock mode
OUTBOX_TRANSPORT_MODE=sink
ONE_TIME_EMAIL_FROM=
ONE_TIME_EMAIL_REPLY_TO=
ONE_TIME_OWNER_TEST_WHATSAPP=
ONE_TIME_OWNER_TEST_EMAIL=

# Production guardrails
ENABLE_REAL_EMAIL_TRANSPORT=false
ENABLE_REAL_WHATSAPP_TRANSPORT=false
ENABLE_REAL_TELEGRAM_TRANSPORT=false
ENABLE_PAYMENT_TRANSPORT=false
