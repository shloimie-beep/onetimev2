#!/usr/bin/env node

import { createHash } from 'node:crypto';

const args = new Set(process.argv.slice(2));
const modeArg = process.argv.find((arg) => arg.startsWith('--mode='));
const mode = modeArg ? modeArg.slice('--mode='.length) : readModeFromSplitArgs();
const json = args.has('--json');

function readModeFromSplitArgs() {
  const index = process.argv.indexOf('--mode');
  return index >= 0 ? process.argv[index + 1] : 'read-only';
}

function result(status, extra = {}) {
  return {
    packet_id: 'OT-86B',
    provider: 'buffer',
    mode,
    status,
    writes_performed: false,
    ...extra,
  };
}

function print(payload) {
  if (json) {
    process.stdout.write(`${JSON.stringify(payload)}\n`);
    return;
  }
  process.stdout.write(`OT-86B Buffer canary: ${payload.status}\n`);
  for (const missing of payload.missing_capability_classes ?? []) {
    process.stdout.write(`missing: ${missing}\n`);
  }
}

main().catch((error) => {
  print(
    result('canary_failed', {
      missing_capability_classes: ['unexpected_canary_error'],
      error_code: sanitizeError(error),
    }),
  );
  process.exit(2);
});

async function main() {
  if (mode !== 'read-only') {
    print(result('invalid_mode', { missing_capability_classes: ['read_only_mode'] }));
    process.exit(2);
  }
  const missing = [
    ['BUFFER_ACCESS_TOKEN', 'access_token'],
    ['BUFFER_ORGANIZATION_ID', 'organization_id'],
    ['BUFFER_DESTINATION_IDS', 'destination_ids'],
  ].filter(([key]) => !process.env[key]);
  if (missing.length > 0) {
    print(
      result('unconfigured', {
        missing_capability_classes: missing.map(([, label]) => label),
        destinations: [],
      }),
    );
    process.exit(2);
  }

  const destinations = String(process.env.BUFFER_DESTINATION_IDS)
    .split(',')
    .map((value) => value.trim())
    .filter(Boolean);
  if (destinations.length < 1) {
    print(
      result('destinations_missing', {
        missing_capability_classes: ['usable_destination_ids'],
        destinations: [],
      }),
    );
    process.exit(2);
  }

  const response = await fetch('https://api.bufferapp.com/1/profiles.json', {
    headers: {
      authorization: `Bearer ${process.env.BUFFER_ACCESS_TOKEN}`,
      accept: 'application/json',
    },
  });
  if (!response.ok) {
    print(
      result('auth_invalid', {
        missing_capability_classes: ['valid_access_token_or_destination_permission'],
        http_status: response.status,
      }),
    );
    process.exit(2);
  }
  const body = await response.json();
  const safeDestinations = Array.isArray(body)
    ? body
        .filter((item) => destinations.includes(String(item.id ?? item.service_id ?? '')))
        .map((item) => ({
          destination_fingerprint: digest(String(item.id ?? item.service_id ?? '')).slice(0, 16),
          service: String(item.service ?? item.service_type ?? 'unknown').slice(0, 40),
        }))
    : [];
  if (safeDestinations.length < 1) {
    print(
      result('destinations_missing', {
        missing_capability_classes: ['configured_destinations_not_accessible'],
        destinations: [],
      }),
    );
    process.exit(2);
  }
  print(
    result('ready_read_only', {
      organization_fingerprint: digest(String(process.env.BUFFER_ORGANIZATION_ID)).slice(0, 16),
      destinations: safeDestinations,
    }),
  );
}

function digest(value) {
  return createHash('sha256').update(value).digest('hex');
}

function sanitizeError(error) {
  return String(error && error.message ? error.message : error)
    .replace(/[A-Za-z0-9_-]{24,}/g, '[redacted-token]')
    .replace(/Bearer\s+[^\s"']+/gi, 'Bearer [redacted-token]')
    .slice(0, 120);
}
