{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ot86:buffer-publish-command:v1",
  "title": "OT86 Buffer Publish Command v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "idempotency_key",
    "tenant_id",
    "draft_id",
    "revision_id",
    "revision_sha256",
    "approval",
    "destination",
    "scheduled_for",
    "timezone",
    "privacy",
    "audit_correlation_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 180,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "tenant_id": {
      "$ref": "#/$defs/id"
    },
    "draft_id": {
      "$ref": "#/$defs/id"
    },
    "revision_id": {
      "$ref": "#/$defs/id"
    },
    "revision_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "approved_by_actor_id",
        "approved_at",
        "policy_version",
        "approved_revision_sha256"
      ],
      "properties": {
        "approval_id": {
          "$ref": "#/$defs/id"
        },
        "approved_by_actor_id": {
          "$ref": "#/$defs/id"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "approved_revision_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "organization_id",
        "destination_id",
        "platform",
        "capability_version"
      ],
      "properties": {
        "provider": {
          "const": "buffer"
        },
        "organization_id": {
          "$ref": "#/$defs/id"
        },
        "destination_id": {
          "$ref": "#/$defs/id"
        },
        "platform": {
          "enum": ["linkedin", "facebook", "instagram", "x"]
        },
        "capability_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "privacy": {
      "$ref": "#/$defs/privacy"
    },
    "audit_correlation_id": {
      "$ref": "#/$defs/id"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contains_learner_name",
        "contains_learner_voice",
        "contains_learner_face",
        "contains_learner_question",
        "contains_private_data",
        "scan_status"
      ],
      "properties": {
        "contains_learner_name": {
          "const": false
        },
        "contains_learner_voice": {
          "const": false
        },
        "contains_learner_face": {
          "const": false
        },
        "contains_learner_question": {
          "const": false
        },
        "contains_private_data": {
          "const": false
        },
        "scan_status": {
          "const": "passed"
        }
      }
    }
  }
}
